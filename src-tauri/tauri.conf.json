{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corte y Queda",
  "version": "0.1.0",
  "identifier": "app.corteyqueda.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Corte y Queda",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
